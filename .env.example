# Clé secrète Flask : générer avec `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-moi
# URL publique (liens des emails, adresse de retour déclarée chez le fournisseur OIDC)
BASE_URL=http://localhost:8002
# Nom par défaut : modifiable ensuite dans Paramètres → Apparence
ASSO_NAME=Mon association
# Base PostgreSQL. Avec docker-compose, seul le mot de passe est à choisir.
POSTGRES_PASSWORD=change-moi-aussi
# Hors Docker : DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@hote:5432/facture
# Dossier des fichiers : logos et PDF des factures émises (data/factures, à sauvegarder avec la base)
DATA_DIR=/data
TZ=Europe/Paris
# Mettre à 1 derrière un reverse proxy (Caddy, Traefik, nginx) qui ajoute X-Forwarded-*
TRUST_PROXY=0
# Adresse d'écoute (Docker) : 127.0.0.1 si le proxy est sur ce serveur. Jamais 0.0.0.0 sur une IP publique.
BIND_ADDR=127.0.0.1
# Inactivité (heures) après laquelle une session qui voit les factures se ferme ; 0 : jamais
IDLE_TIMEOUT_HOURS=8
CSP_REPORT_ONLY=0

# SMTP (facultatif — sans SMTP, les factures ne partent pas par email)
# Le certificat du serveur est toujours vérifié. Port 587 : STARTTLS (SMTP_TLS=true) ; port 465 : TLS direct.
# Relais Google Workspace : SMTP_HOST=smtp-relay.gmail.com, SMTP_PORT=587, SMTP_FROM=une adresse de votre domaine.
#   Autorisé par l'IP du serveur (console Google → Gmail → Relais SMTP) : SMTP_USER et SMTP_PASSWORD vides.
#   Avec authentification SMTP : SMTP_USER=un compte Workspace, SMTP_PASSWORD=un mot de passe d'application.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur : « factures@exemple.fr » ou « Nom <factures@exemple.fr> ». Le nom s'affiche sur tous les emails ;
# sans nom, les factures portent celui de leur émetteur et les autres emails celui de l'association.
SMTP_FROM=
SMTP_TLS=true
# Nom annoncé au serveur (EHLO) ; vide : le domaine de BASE_URL. Le relais Google refuse un nom qui n'est pas un domaine.
SMTP_HELO=

# Connexion par Adhérents (OIDC, facultative). Déclarer l'appli dans Adhérents → Applications avec :
#   adresse de retour  <BASE_URL>/connexion/oidc/retour
#   avis de déconnexion <BASE_URL>/connexion/oidc/deconnexion
#   après déconnexion   <BASE_URL>/connexion
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Adhérents
OIDC_SCOPES=openid email profile groups
OIDC_GROUPS_CLAIM=groups
# Groupes d'Adhérents qui donnent le rôle administrateur (les autres rôles : écran Rôles)
OIDC_ADMIN_GROUPS=
# Rôle d'un compte créé à sa première connexion sans groupe reconnu ; vide : connexion refusée
OIDC_DEFAULT_ROLE=
OIDC_REQUIRE_VERIFIED_EMAIL=1
OIDC_LINK_BY_EMAIL=1
# 1 : connexion par Adhérents seulement (secours administrateur : /connexion?local=1)
OIDC_ONLY=0
OIDC_PROVIDER_LOGOUT=1
